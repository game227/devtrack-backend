SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/devtrack
CORS_ALLOWED_ORIGINS=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=devtest-secret-change-me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/integrations/github/callback/
GITHUB_WEBHOOK_CALLBACK_URL=http://localhost:8000/api/v1/integrations/github/webhook/
# The bot itself (token, webhook) lives in the standalone
# devtrack-telegram-bot service — this app only needs its @username and how
# to reach that service's API. TELEGRAM_LINK_SECRET and BOT_SERVICE_API_KEY
# must match the same-named values in devtrack-telegram-bot's own .env.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_SERVICE_URL=http://localhost:9000
BOT_SERVICE_API_KEY=devtest-bot-api-key-change-me
TELEGRAM_LINK_SECRET=devtest-link-secret-change-me
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev
# OAuth scopes requested from GitHub (space-separated). "repo" covers private repos;
# "public_repo admin:repo_hook" is the narrowest set that still creates webhooks.
GITHUB_OAUTH_SCOPE=repo
# Production only: HSTS in seconds (0 = off) and background password-reset delivery.
SECURE_HSTS_SECONDS=0
PASSWORD_RESET_ASYNC=true

# Push notifications to linked Telegram chats (needs the bot service running).
TELEGRAM_NOTIFICATIONS_ENABLED=false
