SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/devtrack
CORS_ALLOWED_ORIGINS=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=devtest-secret-change-me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/integrations/github/callback/
GITHUB_WEBHOOK_CALLBACK_URL=http://localhost:8000/api/v1/integrations/github/webhook/
# The bot itself (token, webhook) lives in the standalone
# devtrack-telegram-bot service — this app only needs its @username and how
# to reach that service's API. TELEGRAM_LINK_SECRET and BOT_SERVICE_API_KEY
# must match the same-named values in devtrack-telegram-bot's own .env.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_SERVICE_URL=http://localhost:9000
BOT_SERVICE_API_KEY=devtest-bot-api-key-change-me
TELEGRAM_LINK_SECRET=devtest-link-secret-change-me
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev
# Contact address: shown in the app and used as the Reply-To of DevTrack's emails
SUPPORT_EMAIL=safary12800@gmail.com
# OAuth scopes requested from GitHub (space-separated). "repo" covers private repos;
# "public_repo admin:repo_hook" is the narrowest set that still creates webhooks.
GITHUB_OAUTH_SCOPE=repo
# Production only: HSTS in seconds (0 = off) and background password-reset delivery.
SECURE_HSTS_SECONDS=0
PASSWORD_RESET_ASYNC=true

# Push notifications to linked Telegram chats (needs the bot service running).
TELEGRAM_NOTIFICATIONS_ENABLED=false

# --- Hardening (all optional; see SECURITY.md) ---
# Number of reverse proxies in front of the app (read the real client IP from X-Forwarded-For).
# Leave unset until verified on your host; 0 = ignore X-Forwarded-For.
NUM_PROXIES=
# Path of the Django admin; use a long random value in production (default: admin/).
ADMIN_URL=
# Cache for rate-limit counters when running several workers, e.g. dbcache://django_cache
CACHE_URL=
# Largest multipart upload in bytes (default 3 MB).
MAX_UPLOAD_BYTES=

# Error reporting (optional, production settings only): a Sentry DSN turns it on.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Largest issue attachment, in bytes (default 10 MB).
# ATTACHMENT_MAX_BYTES=10485760

# Demo mode ("Try the demo" on the landing page). Off by default.
# DEMO_ENABLED=false
# DEMO_TTL_HOURS=24
# DEMO_MAX_ACTIVE=200

# Web Push (notifications with the app closed). Generate with `manage.py generate_vapid_keys`.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_ASYNC=true
